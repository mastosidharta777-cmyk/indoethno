# One Vercel project, two safe modes:
# - Production (`main`) is always Coming Soon until launch.
# - Preview branch named `pilot` automatically runs the Pilot experience.
# No second Vercel project is required.

# Optional local/non-production override:
# SITE_MODE=pilot

# Required for waitlist / inquiry persistence.
# Keep these server-side. A publishable key is deliberately used with RLS.
# On Vercel, make them available to both Production and Preview.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
